# ══════════════════════════════════════════════════════
# DSA Forge — Environment Variables
# Copy this file to .env.local and fill in the values.
# ══════════════════════════════════════════════════════

# ── Database (required for cloud progress sync) ───────
# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=

# ── AI Providers (at least one required for Forge AI) ──
# Mistral — default provider, used server-side by /api/chat
MISTRAL_API_KEY=

# Gemini — used directly from the browser, so it must be NEXT_PUBLIC.
# Use a key restricted to the Generative Language API.
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional extra providers supported by /api/chat
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── GitHub Activity Tracker (optional, used by /api/track) ──
# Logs saves/mastered events as commits to a tracker repo
# so your practice shows up in your GitHub contribution graph.
GITHUB_PAT=
GITHUB_USERNAME=
GITHUB_TRACKER_REPO=
